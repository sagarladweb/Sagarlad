        </mxCell>
        <mxCell id="fe_txt" value="Next.js 16.3 (React 19)&#xa;TypeScript&#xa;Tailwind CSS&#xa;TipTap Editor&#xa;Lucide Icons&#xa;next/image (optimization)" style="text;html=0;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;" vertex="1" parent="fe_box">
