        </mxCell>
        <mxCell id="be_txt" value="Next.js API Routes (Node.js)&#xa;NextAuth v5 (Google OAuth)&#xa;Prisma ORM&#xa;DOMPurify (XSS)&#xa;Rate Limiter (DB-backed)&#xa;Brevo SDK (emails)" style="text;html=0;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;" vertex="1" parent="be_box">
          <mxGeometry x="5" y="28" width="190" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="svc_box" value="External Services" style="swimlane;startSize=22;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="stack_box">
          <mxGeometry x="440" y="35" width="210" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="svc_txt" value="Supabase (PostgreSQL + Storage)&#xa;Brevo (Newsletter, 300/day free)&#xa;Google Analytics (tracking)&#xa;Cloudflare (email forwarding)&#xa;GitHub Actions (cron drain)&#xa;Vercel (hosting + CDN)" style="text;html=0;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;" vertex="1" parent="svc_box">
