abase.co/storage/v1/object/public/sagarlad-assets/books/abd984cd-0790-43ac-b059-40df4477aa84","buyUrl":"https://www.amazon.com/s?k=The+Mountain+Is+You+Brianna+Wiest","free":false,"featured":false,"sortOrder":2},{"id":"cmswunmt400091trbeho6f6jl","type":"READ","title":"Read People Like a Book","author":"Patrick King","tagline":null,"description":null,"learning":"Reading people is about observing behaviour and context, not guessing minds.","note":null,"imageUrl":"https://vvawladyffozwclpqdhu.supabase.co/storage/v1/object/public/sagarlad-assets/books/d0097ba6-f813-420a-a800-298414674804","buyUrl":"https://www.amazon.com/s?k=Read+People+Like+a+Book+Patrick+King","free":false,"featured":false,"sortOrder":3},{"id":"cmswunn1f000a1trbxmzqo5qo","type":"READ","title":"Life's Amazing Secrets","author":"Gaur Gopal Das","tagline":null,"description":null,"learning":"Success feels empty without anchors for the heart — balance all four wheels of life.","note":null,"imageUrl":"https://vvawladyffozwclpqdhu.supabase.co/storage/v1/object/public/sagarlad-assets/books/df43840b-99d6-4403-bea7-7b20cbcb7f6a","buyUrl":"https://www.amazon.com/s?k=Life%27s+Amazing+Secrets+Gaur+Gopal+Das","free":false,"featured":false,"sortOrder":4},{"id":"cmswunn9s000b1trbxhh88d3a","type":"READ","title":"The Secret","author":"Rhonda Byrne","tagline":null,"description":null,"learning":"What you focus on expands — attention shapes your experience of reality.","note":null,"imageUrl":"https://vvawladyffozwclpqdhu.supabase.co/storage/v1/object/public/sagarlad-assets/books/dc9bf1fe-e346-4668-a56d-f10670376418","buyUrl":"https://www.amazon.com/s?k=The+Secret+Rhonda+Byrne","free":false,"featured":false,"sortOrder":5},{"id":"cmswunni5000c1trbkebdrdqw","type":"READ","title":"The Law of Attraction","author":"Esther & Jerry Hicks","tagline":null,"description":null,"learning":"Your dominant thoughts and feelings attract your reality — feeling good is a compass.","note":null,"imageUrl":"https://vvawladyffozwclpqdhu.supabase.co/storage/v1/object/public/sagarlad-assets/books/a9edf9b2-41dc-4dd2-9b34-7fb96311ee06","buyUrl":"https://www.amazon.com/s?k=The+Law+of+Attraction+Esther+Hicks","free":false,"featured":false,"sortOrder":6},{"id":"cmswunnqg000d1trbtuhxmww5","type":"READ","title":"Who Will Cry When You Die?","author":"Robin Sharma","tagline":null,"description":null,"learning":"Live with intention — service, gratitude and small daily heroics are the point.","note":null,"imageUrl":"https://vvawladyffozwclpqdhu.supabase.co/storage/v1/object/public/sagarlad-assets/books/f6aa4614-abc9-4588-848a-2d91782b02dd","buyUrl":"https://www.amazon.com/s?k=Who+Will+Cry+When+You+Die+Robin+Sharma","free":false,"featured":false,"sortOrder":7},{"id":"cmswunnys000e1trbr5hulspg","type":"READ","title":"How to Win Friends and Influence People","author":"Dale Carnegie","tagline":null,"description":null,"learning":"People respond to genuine interest and appreciation, never criticism.","note":null,"imageUrl":"https://vvawladyffozwclpqdhu.supabase.co/storage/v1/object/public/sagarlad-assets/books/bcaa291c-4ecd-4901-b73d-574437661f94","buyUrl":"https://www.amazon.com/s?k=How+to+Win+Friends+and+Influence+People+Dale+Carnegie","free":false,"featured":false,"sortOrder":8},{"id":"cmswuno74000f1trbdpjpyoc0","type":"READ","title":"How to Stop Worrying and Start Living","author":"Dale Carnegie","tagline":null,"description":null,"learning":"Worry shrinks when you break problems into actions and live one day at a time.","note":null,"imageUrl":"https://vvawladyffozwclpqdhu.supabase.co/storage/v1/object/public/sagarlad-assets/books/be799e1d-99dc-48e6-b08a-cbeb62ae3e89","buyUrl":"https://www.amazon.com/s?k=How+to+Stop+Worrying+and+Start+Living+Dale+Carnegie","free":false,"featured":false,"sortOrder":9},{"id":"cmswunoff000g1trbwzkxfv2l","type":"READ","title":"Think & Grow Rich","author":"Napoleon Hill","tagline":null,"description":null,"learning":"Burning desire, a definite plan and persistence compound into lasting wealth.","