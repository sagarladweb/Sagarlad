8:["$","article",null,{"className":"mx-auto max-w-3xl px-4 sm:px-6 py-16","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"An open letter to my younger self\",\"description\":\"Dear 25-year-old Ankur, you are going to make some expensive mistakes. Here is what I wish you knew.\",\"url\":\"https://sagarlad.com/blog/an-open-letter-to-my-younger-self\",\"datePublished\":\"2026-08-06T09:33:50.804Z\",\"dateModified\":\"2026-08-06T09:33:50.804Z\",\"author\":{\"@type\":\"Person\",\"name\":\"Sagar Lad\",\"url\":\"https://sagarlad.com\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Sagar Lad\",\"url\":\"https://sagarlad.com\"},\"mainEntityOfPage\":\"https://sagarlad.com/blog/an-open-letter-to-my-younger-self\"}"}}],["$","$L12",null,{}],["$","article",null,{"className":"mx-auto max-w-3xl px-4 sm:px-6 py-16","children":[["$","$L6",null,{"href":"/blog","className":"inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors","children":[["$","$L7",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left w-4 h-4"}]," All articles"]}],["$","header",null,{"className":"mt-8","children":[null,null,["$","h1",null,{"className":"mt-3 font-display text-3xl sm:text-4xl md:text-5xl font-bold leading-tight","children":"An open letter to my younger self"}],["$","p",null,{"className":"mt-5 text-lg text-muted-foreground leading-relaxed","children":"Dear 25-year-old Ankur, you are going to make some expensive mistakes. Here is what I wish you knew."}],["$","div",null,{"className":"mt-6 flex flex-wrap items-center gap-2 text-sm text-muted-foreground","children":[["$","span",null,{"className":"font-medium text-foreground","children":"Sagar Lad"}],["$","span",null,{"aria-hidden":"true","children":"·"}],["$","time",null,{"dateTime":"2026-08-06T09:33:50.804Z","children":"6 August 2026"}],["$","span",null,{"aria-hidden":"true","children":"·"}],["$","span",null,{"children":[1," min read"]}]]}]]}],["$","div",null,{"className":"my-8 h-px bg-border"}],["$","div",null,{"id":"post-content","children":[null,["$","div",null,{"className":"tip-content","dangerouslySetInnerHTML":{"__html":"\n<h2>Start with awareness</h2>\n<p>Every big change in my life started with a simple realisation — that I was not paying attention to what mattered most. Awareness is the first step towards everything.</p>\n<blockquote><p>“Awareness is everything.”</p></blockquote>\n<h3>Money is a tool, not a goal</h3>\n<p>When I stopped chasing money and started chasing <strong>time and energy</strong>, everything changed. The goal was never to be rich — it was to be <em>free</em>.</p>\n<ul><li><p>Build assets that buy back your time.</p></li><li><p>Invest early, invest often, keep it boring.</p></li><li><p>Never let a fancy car define your worth.</p></li></ul>\n<h3>The 3-step process that works</h3>\n<ol><li><p>Write down what you want.</p></li><li><p>Figure out the cost.</p></li><li><p>Pay it in advance.</p></li></ol>\n<p>That's it. That's the whole secret. Everything else is noise.</p>\n"}}]]}],null,["$","div",null,{"className":"mt-6 flex items-center gap-4 rounded-2xl border border-border bg-card p-6","children":[["$","div",null,{"className":"grid h-12 w-12 shrink-0 place-items-center rounded-full bg-accent font-display text-lg font-bold text-accent-foreground","children":"S"}],["$","div",null,{"children":[["$","p",null,{"className":"font-display font-bold","children":"Sagar Lad"}],["$","p",null,{"className":"mt-0.5 text-sm text-muted-foreground","children":"Practical frameworks on money, career, life and awareness — from author, investor and educator Sagar Lad. Blog, books and more."}]]}]]}],"$L13"]}]]}]
