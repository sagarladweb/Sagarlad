# NextAuth v5 — required in production.
# ⚠️  AUTH_SECRET: generate with `openssl rand -base64 32`
# ⚠️  AUTH_URL: use HTTPS in production (e.g. https://admin.sagarlad.com)
AUTH_SECRET=
AUTH_URL=https://localhost:3001

# First admin account seeded into the DB.
# ⚠️  ADMIN_PASSWORD: use a strong, unique password (20+ chars recommended)
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASSWORD=your-strong-password

# Copy to .env locally, and set each var in the Vercel project
# (Settings -> Environment Variables) so the deployed admin can run.

# Postgres (Supabase). DATABASE_URL via the transaction pooler,
# DIRECT_URL for prisma migrate/deploy.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_POOL_MAX=5

# Supabase Storage (media, covers).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Analytics 4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=your-property-id

# Google Analytics service account JSON (base64-encoded).
# Generate: base64 -i your-service-account.json | pbcopy
GOOGLE_SERVICE_ACCOUNT_JSON=

# Brevo newsletter sending.
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=noreply@sagarlad.com
BREVO_FROM_NAME=Sagar Lad
DAILY_EMAIL_LIMIT=300
NEWSLETTER_BATCH_SIZE=50

# GitHub Actions cron guard.
CRON_SECRET=
NEWSLETTER_CRON=

# GitHub token for repo operations.
Github_access_token=your-github-token

# Public site origin the admin revalidates after writes (default: https://sagarlad.com).
SITE_URL=https://sagarlad.com

# Set to "1" to lock the admin to Phase 1 features.
ADMIN_PHASE=2
