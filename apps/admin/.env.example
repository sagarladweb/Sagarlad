# ─────────────────────────────────────────────────────────────────────────────
# SAGAR LAD — Admin Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env locally, and set each var in the Vercel project
# (Settings → Environment Variables) so the deployed admin can run.
# The build succeeds without these; they are required at runtime.
#
# ⚠️  NEVER commit .env to git. Use .env.example as the template.
# ⚠️  This file contains no secrets — only placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Supabase/Neon). DATABASE_URL via the transaction pooler,
# DIRECT_URL for prisma migrate/deploy.
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_MAX=5

# NextAuth v5 — required in production.
# ⚠️  AUTH_SECRET: generate with `openssl rand -base64 32`
# ⚠️  AUTH_URL: use HTTPS in production (e.g. https://admin.sagarlad.com)
AUTH_SECRET=
AUTH_URL=https://localhost:3001

# First admin account seeded into the DB.
# ⚠️  ADMIN_PASSWORD: use a strong, unique password (20+ chars recommended)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase Storage (uploads, e-books, media).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Brevo newsletter sending.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
DAILY_EMAIL_LIMIT=50
NEWSLETTER_BATCH_SIZE=50

# GitHub Actions cron guard.
# ⚠️  CRON_SECRET: generate with `openssl rand -hex 32`
# Required — the cron endpoint rejects requests without it.
CRON_SECRET=
NEWSLETTER_CRON=

# Public site origin the admin revalidates after writes (default: https://sagarlad.com).
SITE_URL=https://sagarlad.com

# Set to "1" to lock the admin to Phase 1 features.
ADMIN_PHASE=2
