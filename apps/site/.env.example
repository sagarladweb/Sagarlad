# Copy to .env locally, and set each var in the Vercel project
# (Settings -> Environment Variables) so the deployed site can run.

# Postgres (Supabase/Neon). DATABASE_URL via the transaction pooler,
# DIRECT_URL for prisma migrate/deploy.
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_MAX=5

# NextAuth v5 — required in production.
AUTH_SECRET=

# Supabase Storage (media, covers).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Brevo newsletter sending.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
DAILY_EMAIL_LIMIT=50
NEWSLETTER_BATCH_SIZE=50

# GitHub Actions cron guard.
CRON_SECRET=
NEWSLETTER_CRON=